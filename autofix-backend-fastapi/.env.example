# ==========================
# AutoFix — Variables de entorno
# Copia este archivo como .env y ajusta los valores.
# ==========================

# Entorno: development (local) o production (nube)
# En production se EXIGEN varias medidas de seguridad (ver abajo).
ENVIRONMENT=development

# Seguridad / JWT
# OBLIGATORIO cambiarla en producción (mínimo 32 caracteres).
# Genera una segura con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=autofix-sena-2026-clave-ultra-secreta-cambiar-en-produccion
ALGORITHM=HS256
# Expiración del token en minutos (1440 = 24 horas)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Base de datos
# SQLite por defecto (desarrollo local, sin instalación extra):
DATABASE_URL=sqlite:///./autofix.db
# PostgreSQL en producción (Render/Railway la entregan automáticamente):
# DATABASE_URL=postgresql://usuario:clave@host:5432/autofix
#
# Neon entrega dos cadenas para la misma base:
#   - DATABASE_URL: la del POOLER (host con "-pooler"), para la aplicación.
#   - DATABASE_URL_DIRECTA: la directa, para Alembic, pg_dump y pg_restore.
# Nunca escribas URLs reales en el repositorio (es público).
# DATABASE_URL_DIRECTA=postgresql://usuario:clave@host-sin-pooler:5432/autofix?sslmode=require
#
# Pool de SQLAlchemy (solo PostgreSQL):
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_CONNECT_TIMEOUT=15

# CORS (orígenes permitidos, separados por coma)
# En producción pon aquí la URL de tu frontend, ej: https://tu-app.netlify.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Servidor
SERVER_HOST=0.0.0.0
SERVER_PORT=8081
DEBUG=false

# Documentación interactiva (/docs). En producción viene desactivada;
# actívala explícitamente solo si la necesitas:
# DOCS_ENABLED=true

# Límite de peticiones anti fuerza bruta en login/registro (recomendado: true)
RATE_LIMIT_ENABLED=true

# Usuarios iniciales (usado por: python -m app.seed)
# OBLIGATORIAS: el seed falla si faltan. Define aquí tus propias credenciales.
# Las contraseñas deben tener mínimo 12 caracteres.
AUTOFIX_ADMIN_EMAIL=admin@autofix.com
AUTOFIX_ADMIN_PASSWORD=cambia-esta-clave-minimo-12-caracteres
AUTOFIX_SUPERADMIN_EMAIL=superadmin@autofix.com
AUTOFIX_SUPERADMIN_PASSWORD=cambia-esta-clave-minimo-12-caracteres
