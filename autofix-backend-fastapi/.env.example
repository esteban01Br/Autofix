# ==========================
# AutoFix — Variables de entorno
# Copia este archivo como .env y ajusta los valores.
# ==========================

# Seguridad / JWT
# Cambia esta clave en producción (mínimo 32 caracteres).
SECRET_KEY=autofix-sena-2026-clave-ultra-secreta-cambiar-en-produccion
ALGORITHM=HS256
# Expiración del token en minutos (1440 = 24 horas)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Base de datos
# SQLite por defecto (sin instalación extra):
DATABASE_URL=sqlite:///./autofix.db
# Para MySQL descomenta y usa (requiere: pip install pymysql):
# DATABASE_URL=mysql+pymysql://root:@localhost:3306/autofix_db

# CORS (orígenes permitidos, separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Servidor
SERVER_HOST=0.0.0.0
SERVER_PORT=8081
DEBUG=false

# Usuario administrador inicial (usado por: python -m app.seed)
# Los valores mostrados son solo fallback de desarrollo.
AUTOFIX_ADMIN_EMAIL=admin@autofix.com
AUTOFIX_ADMIN_PASSWORD=Admin123!