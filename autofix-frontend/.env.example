# ==========================
# AutoFix Frontend - Variables de entorno (Vite)
# Copia este archivo como .env.local y completa solo lo que necesites.
# En desarrollo el proxy de Vite reenvía /api al backend local.
# En producción las URLs deben apuntar a los despliegues en Netlify.
# ==========================

# URL pública del backend (sin barra final).
# Ejemplo de formato: https://api.tu-dominio.com
# En producción deberías poner la URL de tu servicio Netlify/Render.
VITE_API_URL=https://autofix-api-tm6d.onrender.com

# URL pública del portal de ventas (sin barra final).
# Ejemplo de formato: https://tu-dominio.com
# En producción deberías poner la URL de tu despliegue Netlify.
# Este valor se incrusta al compilar en Vite y debe coincidir con el sitio Netlify del portal.
VITE_PORTAL_URL=https://TU-PORTAL.netlify.app