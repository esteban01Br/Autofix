# ==========================
# AutoFix Portal - Variables de entorno (Vite)
# Copia este archivo como .env.local y completa solo lo que necesites.
# En desarrollo no hace falta: el proxy de Vite reenvía /api al backend.
# ==========================

# URL pública del backend (sin barra final).
# Ejemplo de formato: https://api.tu-dominio.com
# En producción deberías poner la URL de tu servicio Netlify/Render.
VITE_API_URL=https://autofix-api-tm6d.onrender.com

# URL pública del panel del taller (sin barra final).
# Ejemplo de formato: https://app.tu-dominio.com
# En producción deberías poner la URL de tu despliegue Netlify.
# Este valor se incrusta al compilar en Vite y debe coincidir con el sitio Netlify del panel.
VITE_APP_URL=https://TU-PANEL.netlify.app